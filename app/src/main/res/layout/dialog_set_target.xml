<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:text="@string/target_setup_title"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666666"
        android:text="@string/target_setup_description"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etTargetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:maxLength="4"
        android:hint="@string/target_setup_hint"
        android:textColor="#000000"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvTargetError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_missed"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:text="@string/invalid_number_error"
        android:visibility="gone" />

</LinearLayout>
